# App

APP_NAME="Titanium Rental Car"

APP_URL=http://localhost

APP_BASE=

# Landing pública na raiz (/) para visitantes. false = redireciona direto para /login

APP_LANDING=true



# Chave para cifrar segredos (TOTP). Gere com: php -r "echo bin2hex(random_bytes(32));"

APP_KEY=



# LGPD — dados exibidos em /privacidade (preencha em produção)

PRIVACY_CONTROLLER_NAME=

PRIVACY_CONTROLLER_CNPJ=

PRIVACY_ADDRESS=

PRIVACY_DPO_EMAIL=

PRIVACY_DPO_PHONE=

# Reporte de vulnerabilidades (/.well-known/security.txt)
SECURITY_CONTACT_EMAIL=

# Em produção: bloqueia login das contas demo do seed (owner@, operator@, partner@)
ALLOW_DEMO_LOGIN=false

APP_ENV=development

APP_DEBUG=true

APP_DEFAULT_LANG=pt-BR

APP_PER_PAGE=15



# Database

DB_HOST=127.0.0.1

DB_PORT=3306

DB_DATABASE=titanium_rental_car

DB_USERNAME=root

DB_PASSWORD=



# Session (defina SESSION_SECURE=true em produção com HTTPS)

SESSION_LIFETIME=480

SESSION_SECURE=false



# Upload

MAX_UPLOAD_SIZE=5242880

UPLOAD_PATH=public/assets/uploads



# Contact (site público e rodapé)
CONTACT_WHATSAPP=5511999999999
CONTACT_PHONE=(11) 3000-1000
CONTACT_EMAIL=reservas@titaniumrental.com.br
CONTACT_ADDRESS=Av. Paulista, 1000 — Bela Vista, São Paulo — SP

# Dados comerciais (landing e rodapé)
BUSINESS_LEGAL_NAME=Titanium Rental Car Ltda
BUSINESS_CNPJ=
BUSINESS_HOURS=Segunda a sábado, 8h às 18h
BUSINESS_MIN_RATE=R$ 99,90
BUSINESS_RESPONSE_TIME=2 horas úteis

# Mail (optional SMTP — in dev, emails are saved to storage/mail/)
MAIL_FROM=noreply@titaniumrental.local
MAIL_FROM_NAME="Titanium Rental Car"
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_SMTP_USER=
MAIL_SMTP_PASS=
MAIL_SMTP_SECURE=tls

# Notificações internas (opcional — senão usa e-mails de owner/operator activos)
MAIL_NOTIFY=

# Health check — obrigatório em produção (GET /health?token=…)

HEALTH_TOKEN=

# Webhook opcional para alertas (Slack/Discord) em erros AppLog
MONITORING_WEBHOOK_URL=

