# App
APP_NAME="Titanium Rental Car"
APP_URL=http://localhost
APP_BASE=
# Landing pública na raiz (/) para visitantes. false = redireciona direto para /login
APP_LANDING=true

# LGPD — dados exibidos em /privacidade (preencha em produção)
PRIVACY_CONTROLLER_NAME=
PRIVACY_CONTROLLER_CNPJ=
PRIVACY_ADDRESS=
PRIVACY_DPO_EMAIL=
PRIVACY_DPO_PHONE=
SECURITY_CONTACT_EMAIL=
# E-mail para notificar novos leads (opcional; usa SECURITY_CONTACT_EMAIL se vazio)
MAIL_NOTIFY=
# log = grava em storage/logs/mail.log | mail = PHP mail()
MAIL_DRIVER=log
MAIL_FROM=noreply@localhost
MAIL_FROM_NAME="Titanium Rental Car"
# Em produção: APP_ENV=production, APP_DEBUG=false
APP_ENV=development
APP_DEBUG=true
APP_DEFAULT_LANG=pt-BR
APP_PER_PAGE=15

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=titanium_rental_car
DB_USERNAME=root
DB_PASSWORD=

# Session
# Produção: 120–240 min recomendado
SESSION_LIFETIME=480
SESSION_SECURE=false

# Upload
MAX_UPLOAD_SIZE=5242880
UPLOAD_PATH=public/assets/uploads
