# Staging — copie para .env no servidor de homologação

APP_NAME="Titanium Rental Car (Staging)"
APP_URL=https://staging.seudominio.com.br
APP_ENV=staging
APP_DEBUG=false
APP_KEY=
APP_LANDING=true

SESSION_SECURE=true
SESSION_LIFETIME=480

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=titanium_rental_staging
DB_USERNAME=
DB_PASSWORD=

# Mesmas chaves que produção, valores de staging
HEALTH_TOKEN=
PRIVACY_DPO_EMAIL=
SECURITY_CONTACT_EMAIL=
CONTACT_EMAIL=
MAIL_SMTP_HOST=
MAIL_SMTP_USER=
MAIL_SMTP_PASS=

ALLOW_DEMO_LOGIN=true
MONITORING_WEBHOOK_URL=

# Staging usa APP_ENV=staging — ProductionGuard não bloqueia (só production)
