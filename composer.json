{
  "name": "titanium/rental-car",
  "description": "Titanium Rental Car — SaaS de locação",
  "type": "project",
  "require": {
    "php": ">=8.3"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.3",
    "phpstan/phpstan": "^2.0",
    "roave/security-advisories": "dev-latest"
  },
  "autoload": {
    "classmap": [
      "app/helpers",
      "app/middleware",
      "app/controllers",
      "app/models",
      "app/services"
    ],
    "files": [
      "app/bootstrap.php"
    ]
  },
  "scripts": {
    "test": "phpunit",
    "phpstan": "phpstan analyse --memory-limit=512M"
  },
  "config": {
    "sort-packages": true
  }
}
